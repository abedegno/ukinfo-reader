# Copy to an ignored .env file. Use independent URL-safe random hex passwords.
UKINFO_DB_PASSWORD=
UKINFO_SEARCH_PASSWORD=
UKINFO_PUBLIC_ORIGIN=https://archive.example.org
UKINFO_IMAGE_TAG=local
UKINFO_BACKUP_DIR=../private/production-backups
# Set to the host user's numeric IDs for private monitor state files.
UKINFO_MONITOR_UID=1000
UKINFO_MONITOR_GID=1000
# Empty means delivery is disabled; status/checks still run.
UKINFO_ALERT_FILE=/dev/null
